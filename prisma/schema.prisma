// UpaHealth Procurement System — Database Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  SALES_USER
  VIEWER
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum LeadType {
  HOSPITAL
  GOVERNMENT
  DISTRIBUTOR
  HOSPITAL_CHAIN
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES_USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions   Session[]
  quotations Quotation[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================
// SUPPLIER
// ============================================

model Supplier {
  id                   String   @id @default(cuid())
  name                 String
  location             String
  contactPhone         String
  email                String
  certifications       String[] // ISO 13485, CE Mark, WHO GMP, etc.
  productCategories    String[] // Product category names
  reliabilityScore     Float    @default(0)
  trustScore           Float    @default(0)
  totalOrders          Int      @default(0)
  onTimeDelivery       Float    @default(0) // Percentage 0-100
  qualityRejectionRate Float    @default(0) // Percentage 0-100
  archived             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  products Product[]

  @@map("suppliers")
}

// ============================================
// PRODUCT
// ============================================

model Product {
  id               String   @id @default(cuid())
  name             String
  category         String
  sku              String   @unique
  costPrice        Float
  sellingPrice     Float // INR
  exportPrice      Float // USD
  moq              Int
  unit             String
  supplierId       String
  leadTime         String
  certifications   String[]
  exportAvailable  Boolean  @default(true)
  stock            Int      @default(0)
  competitorPriceMin Float? // For AI pricing suggestions
  competitorPriceMax Float?
  targetMargin     Float?   // Category-specific target margin %
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  lineItems QuotationLineItem[]

  @@map("products")
}

// ============================================
// QUOTATION
// ============================================

model Quotation {
  id            String          @id @default(cuid())
  quotationId   String          @unique // UH-Q-YYYYMMDD-NNN format
  buyerName     String
  buyerEmail    String?
  buyerAddress  String?
  buyerCountry  String?
  currency      String          @default("INR")
  validityDays  Int             @default(30)
  status        QuotationStatus @default(DRAFT)
  subtotal      Float           @default(0)
  totalDiscount Float           @default(0)
  totalGST      Float           @default(0)
  freight       Float           @default(0)
  grandTotal    Float           @default(0)
  notes         String?
  createdById   String
  leadId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  expiresAt     DateTime?

  createdBy User              @relation(fields: [createdById], references: [id])
  lead      Lead?             @relation(fields: [leadId], references: [id])
  lineItems QuotationLineItem[]

  @@map("quotations")
}

model QuotationLineItem {
  id            String @id @default(cuid())
  quotationId   String
  productId     String
  productName   String
  quantity      Int
  unitPrice     Float
  costPrice     Float
  gstRate       Float  @default(0)
  discount      Float  @default(0) // Percentage
  lineTotal     Float  @default(0)
  marginPercent Float  @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_line_items")
}

// ============================================
// CRM / LEADS
// ============================================

model Lead {
  id              String    @id @default(cuid())
  name            String
  type            LeadType
  contactPerson   String
  email           String?
  phone           String?
  stage           String    @default("Lead") // Pipeline stage name
  estimatedValue  Float     @default(0)
  products        String[]  // Associated product category names
  lastContactDate DateTime?
  nextFollowUp    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  quotations  Quotation[]
  transitions LeadStageTransition[]

  @@map("leads")
}

model LeadStageTransition {
  id        String   @id @default(cuid())
  leadId    String
  fromStage String
  toStage   String
  changedAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_stage_transitions")
}

// ============================================
// TENDERS
// ============================================

model Tender {
  id           String   @id @default(cuid())
  externalId   String   @unique // ID from source
  source       String   // "GeM", "CPPP", "eProcure", "State"
  title        String
  organization String
  category     String?
  value        Float?   // Estimated value in INR
  currency     String   @default("INR")
  deadline     DateTime?
  publishedAt  DateTime?
  status       String   @default("open") // open, closed, awarded
  url          String?
  aiMatchScore Int      @default(0) // 0-100 AI match score
  aiSummary    String?  // AI-generated summary
  matchedProducts String[] // Product categories that match
  saved        Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tenders")
}

// ============================================
// AI OPERATING SYSTEM
// ============================================

model AIAgent {
  id              String   @id @default(cuid())
  name            String   @unique // "CEO", "Sales", "CRM", etc.
  role            String   // Display title
  description     String
  status          String   @default("active") // active, paused, error
  modelProvider   String   @default("nvidia") // nvidia, openai, claude
  modelName       String   @default("meta/llama-3.1-8b-instruct")
  systemPrompt    String   @db.Text
  capabilities    String[] // ["read_db", "write_db", "send_email", "scan_tenders"]
  schedule        String?  // cron expression for autonomous runs
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  totalRuns       Int      @default(0)
  successRuns     Int      @default(0)
  failedRuns      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks      AITask[]
  reports    AIReport[]
  activities AIActivity[]

  @@map("ai_agents")
}

model AITask {
  id          String   @id @default(cuid())
  agentId     String
  title       String
  description String?  @db.Text
  status      String   @default("pending") // pending, running, completed, failed
  priority    String   @default("medium") // low, medium, high, urgent
  input       Json?
  output      Json?
  error       String?  @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  createdAt   DateTime @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("ai_tasks")
}

model AIReport {
  id          String   @id @default(cuid())
  agentId     String
  type        String   // "daily_ceo", "weekly_sales", "tender_summary"
  title       String
  summary     String   @db.Text
  data        Json
  insights    String[] // AI-generated insights
  recommendations String[]
  createdAt   DateTime @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id])

  @@map("ai_reports")
}

model AIActivity {
  id        String   @id @default(cuid())
  agentId   String
  action    String   // "scanned_tenders", "scored_lead", "sent_email"
  target    String?  // "lead:abc123", "tender:xyz789"
  details   Json?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("ai_activities")
}

model AIRecommendation {
  id          String   @id @default(cuid())
  agentName   String   // Which agent created it
  category    String   // "sales", "procurement", "export", "social"
  priority    String   @default("medium")
  title       String
  description String   @db.Text
  actionable  Boolean  @default(true)
  status      String   @default("pending") // pending, accepted, rejected, done
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("ai_recommendations")
}

model LeadScore {
  id              String   @id @default(cuid())
  leadId          String   @unique
  overallScore    Int      @default(0) // 0-100
  intentScore     Int      @default(0)
  fitScore        Int      @default(0)
  engagementScore Int      @default(0)
  closeProbability Int     @default(0) // 0-100
  reasoning       String   @db.Text
  nextBestAction  String?
  scoredAt        DateTime @default(now())

  @@map("lead_scores")
}

model SupplierScore {
  id                String   @id @default(cuid())
  supplierId        String   @unique
  reliabilityScore  Int      @default(0)
  qualityScore      Int      @default(0)
  pricingScore      Int      @default(0)
  responseScore     Int      @default(0)
  overallScore      Int      @default(0)
  riskLevel         String   @default("low") // low, medium, high
  insights          String[]
  scoredAt          DateTime @default(now())

  @@map("supplier_scores")
}

model SocialPost {
  id          String   @id @default(cuid())
  platform    String   // "instagram", "linkedin", "twitter"
  type        String   // "post", "reel", "carousel", "story"
  status      String   @default("draft") // draft, scheduled, published, failed
  caption     String   @db.Text
  hashtags    String[]
  mediaUrls   String[]
  topic       String?
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String?  // ID on the platform
  metrics     Json?    // likes, comments, reach, etc.
  createdAt   DateTime @default(now())

  @@map("social_posts")
}

model OutreachCampaign {
  id            String   @id @default(cuid())
  name          String
  channel       String   // "email", "linkedin", "whatsapp"
  audience      String   // "hospitals_india", "africa_buyers", etc.
  status        String   @default("draft") // draft, active, paused, completed
  subject       String?
  body          String?  @db.Text
  totalSent     Int      @default(0)
  totalOpened   Int      @default(0)
  totalReplied  Int      @default(0)
  totalConverted Int     @default(0)
  startedAt     DateTime?
  createdAt     DateTime @default(now())

  messages OutreachMessage[]

  @@map("outreach_campaigns")
}

model OutreachMessage {
  id           String   @id @default(cuid())
  campaignId   String
  recipientName String
  recipientEmail String?
  recipientPhone String?
  channel      String
  subject      String?
  body         String   @db.Text
  status       String   @default("queued") // queued, sent, delivered, opened, replied, failed
  sentAt       DateTime?
  openedAt     DateTime?
  repliedAt    DateTime?
  reply        String?  @db.Text
  sentiment    String?  // positive, neutral, negative
  intent       String?  // interested, not_interested, needs_info
  createdAt    DateTime @default(now())

  campaign OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("outreach_messages")
}

model ExportBuyer {
  id              String   @id @default(cuid())
  companyName     String
  country         String
  region          String   // "East Africa", "GCC", "SAARC"
  contactPerson   String?
  email           String?
  phone           String?
  website         String?
  linkedinUrl     String?
  source          String   // "linkedin", "indiamart", "manual"
  productInterest String[]
  status          String   @default("new") // new, contacted, engaged, qualified, customer
  enrichmentData  Json?
  aiNotes         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("export_buyers")
}

model CEODashboardMetric {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  revenue     Float    @default(0)
  pipelineValue Float  @default(0)
  activeLeads Int      @default(0)
  hotLeads    Int      @default(0)
  newTenders  Int      @default(0)
  exportLeads Int      @default(0)
  socialReach Int      @default(0)
  aiAgentRuns Int      @default(0)
  alerts      Json?    // [{level, message, action}]
  insights    String[] // AI-generated daily insights

  @@unique([date])
  @@map("ceo_dashboard_metrics")
}

// ============================================
// EMAIL COMMUNICATIONS LOG
// ============================================

model EmailLog {
  id          String   @id @default(cuid())
  to          String   // Recipient email
  cc          String?  // CC recipients
  bcc         String?  // BCC recipients
  subject     String
  body        String   @db.Text // HTML body
  template    String?  // "quotation", "follow-up", "custom"
  status      String   @default("sent") // sent, failed, bounced
  messageId   String?  // SMTP message ID
  relatedType String?  // "quotation", "lead", "supplier"
  relatedId   String?  // ID of related entity
  sentById    String?  // User who sent it
  errorMsg    String?  // Error message if failed
  sentAt      DateTime @default(now())

  @@index([to])
  @@index([relatedType, relatedId])
  @@index([sentAt])
  @@map("email_logs")
}

// ============================================
// LEAD GENERATION SEARCHES
// ============================================

model LeadSearch {
  id            String   @id @default(cuid())
  market        String
  segment       String
  productFocus  String
  count         Int
  generatedCount Int     @default(0)
  savedCount    Int      @default(0)
  status        String   @default("completed") // completed, failed
  aiOutput      Json?    // Full AI response
  createdAt     DateTime @default(now())

  @@map("lead_searches")
}

// ============================================
// AI OUTREACH EMAILS
// ============================================

model OutreachEmail {
  id          String   @id @default(cuid())
  leadId      String
  leadName    String   @default("")   // Cached lead name
  toEmail     String   @default("")   // Recipient email address
  subject     String
  body        String   @db.Text
  status      String   @default("draft") // draft, sent, failed
  sentAt      DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?
  deletedAt   DateTime?              // Soft delete
  createdAt   DateTime @default(now())

  @@map("outreach_emails")
}

// ============================================
// APP SETTINGS (persisted to Supabase)
// ============================================

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ============================================
// EMAIL ATTACHMENTS
// ============================================

model EmailAttachment {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int      // bytes
  data      String   @db.Text // base64 encoded
  createdAt DateTime @default(now())

  @@map("email_attachments")
}

// ============================================
// MAILBOX — INBOX, THREADS & FILE SHARING
// ============================================

model MailboxMessage {
  id          String   @id @default(cuid())
  threadId    String?  // Group into conversation threads
  direction   String   // "inbound" or "outbound"
  from        String   // Sender email
  fromName    String?  // Sender display name
  to          String   // Recipient email
  toName      String?  // Recipient display name
  cc          String?
  subject     String
  bodyText    String?  @db.Text
  bodyHtml    String?  @db.Text
  snippet     String?  // First ~100 chars preview
  status      String   @default("unread") // unread, read, archived, starred, trash
  starred     Boolean  @default(false)
  labels      String[] // "important", "customer", "supplier", etc.
  messageId   String?  // SMTP message ID for threading
  inReplyTo   String?  // SMTP In-Reply-To header
  references  String[] // SMTP References header
  relatedType String?  // "lead", "quotation", "customer"
  relatedId   String?
  sentAt      DateTime @default(now())
  readAt      DateTime?
  createdAt   DateTime @default(now())

  thread      MailThread?      @relation(fields: [threadId], references: [id])
  attachments SharedFile[]

  @@index([threadId])
  @@index([from])
  @@index([to])
  @@index([status])
  @@index([sentAt])
  @@map("mailbox_messages")
}

model MailThread {
  id              String   @id @default(cuid())
  subject         String
  participants    String[] // All email addresses in the thread
  lastMessageAt   DateTime @default(now())
  messageCount    Int      @default(1)
  unreadCount     Int      @default(0)
  status          String   @default("active") // active, archived, trash
  starred         Boolean  @default(false)
  labels          String[]
  relatedType     String?  // "lead", "quotation", "customer"
  relatedId       String?
  createdAt       DateTime @default(now())

  messages MailboxMessage[]

  @@index([lastMessageAt])
  @@index([status])
  @@map("mail_threads")
}

model SharedFile {
  id            String   @id @default(cuid())
  filename      String
  mimeType      String
  size          Int      // bytes
  data          String   @db.Text // base64 encoded
  description   String?
  category      String   @default("general") // "pdf", "catalog", "quotation", "brochure", "certificate"
  sharedWith    String[] // Email addresses shared with
  relatedType   String?  // "lead", "customer", "supplier"
  relatedId     String?
  messageId     String?  // Linked to a mailbox message
  downloadCount Int      @default(0)
  uploadedById  String?
  createdAt     DateTime @default(now())

  message MailboxMessage? @relation(fields: [messageId], references: [id])

  @@index([category])
  @@index([messageId])
  @@index([uploadedById])
  @@map("shared_files")
}
